---
import P from "../components/Paragraph.astro";
import NavLink from "../components/NavLink.astro";
import "../styles/global.css";
import Badge from "../components/Badge.astro";
import Link from "../components/Link.astro";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<slot name="head" />
		<title>{title}</title>
	</head>
	<body class="flex flex-col items-center h-screen w-screen bg-gray-100 dark:bg-gray-800 text-generic-black dark:text-generic-white">
		<nav class="flex flex-row h-fit w-screen text-gray-950 dark:text-gray-50 bg-gray-300 dark:bg-gray-600 text-xl">
			<NavLink link="/">Vulpixel</NavLink>
			<NavLink link="/about">About</NavLink>
			<NavLink link="/test">Test</NavLink>
			<div class="flex flex-row self-center sticky left-full lg:px-2 sm:px-1">
				<slot name="navbar" />
				<Badge id="discord-plural" category="social" size="compact-minimal" url="/discord" />
				<Badge id="git" category="available" size="compact-minimal" url="https://tangled.org/vulpixel.org" />
			</div>
		</nav>
		<main class="md:min-w-[80ch] min-w-screen max-w-[80ch] flex flex-col justify-left lg:pt-8 md:pt-4 pt-2 lg:p-0 p-3">
			<slot />
		</main>
		<footer class="grid grid-cols-1 justify-items-center sticky top-full lg:pt-4 lg:pb-4 md:pb-2 md:pt-2 text-gray-950 dark:text-gray-50 bg-gray-300 dark:bg-gray-600 h-fit w-screen ">
			<slot name="footer" />
			<P>Copyright (c) Sylv, Vulpixel, {new Date().getUTCFullYear()}</P>
			<P><Link url="https://github.com/VulpixelMC/website">Website Source Code</Link></P>
		</footer>
	</body>
</html>
